load("//:defs.bzl", "GNU_TRIPLE")

# ---------------------------------------------------------------------------
# parson: compiled directly into libecho (see //runtime:echo), we just
# export the source and a header mapped to the repo-relative include path
# the runtime sources use.
# ---------------------------------------------------------------------------

export_file(
    name = "parson.c",
    src = "parson/parson.c",
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "parson-headers",
    header_namespace = "",
    exported_headers = {
        "external-deps/parson/parson.h": "parson/parson.h",
        # parson.c itself includes it unqualified
        "parson.h": "parson/parson.h",
    },
    visibility = ["PUBLIC"],
)

# ---------------------------------------------------------------------------
# pcre: autotools build.  Produces libpcre16.a plus the configure-generated
# pcre.h that runtime/ejs-regexp.c includes as "external-deps/pcre/pcre.h".
# ---------------------------------------------------------------------------

genrule(
    name = "pcre-build",
    srcs = glob(["pcre/**"]),
    outs = {
        "lib": ["libpcre16.a"],
        "header": ["pcre.h"],
    },
    default_outs = ["libpcre16.a"],
    cmd = 'set -e; BUILD="$TMP/pcre-build"; mkdir -p "$BUILD"; ' +
          'SRC="$PWD/$SRCDIR/pcre"; ' +
          '(cd "$BUILD" && "$SRC/configure" --build=' + GNU_TRIPLE +
          ' --enable-pcre16 --enable-utf --disable-cpp >configure.log 2>&1 && ' +
          'make pcre_chartables.c libpcre16.la >build.log 2>&1) || { cat "$BUILD"/*.log; exit 1; }; ' +
          'cp "$BUILD/.libs/libpcre16.a" "$OUT/libpcre16.a"; ' +
          'cp "$BUILD/pcre.h" "$OUT/pcre.h"',
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "pcre-headers",
    header_namespace = "",
    exported_headers = {
        "external-deps/pcre/pcre.h": ":pcre-build[header]",
    },
    visibility = ["PUBLIC"],
)

# ---------------------------------------------------------------------------
# double-conversion: cmake build for the static lib; headers come straight
# from the source tree, remapped to the repo-relative include path
# runtime/ejs-dtoa.cpp uses.
# ---------------------------------------------------------------------------

genrule(
    name = "double-conversion-build",
    srcs = glob(["double-conversion/**"]),
    out = "libdouble-conversion.a",
    cmd = 'set -e; BUILD="$TMP/dc-build"; mkdir -p "$BUILD"; ' +
          'SRC="$PWD/$SRCDIR/double-conversion"; ' +
          '(cd "$BUILD" && cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_BUILD_TYPE=Release "$SRC" >cmake.log 2>&1 && ' +
          'make >build.log 2>&1) || { cat "$BUILD"/*.log; exit 1; }; ' +
          'cp "$BUILD/double-conversion/libdouble-conversion.a" "$OUT"',
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "double-conversion-headers",
    header_namespace = "",
    exported_headers = {
        "external-deps/double-conversion/" + h.removeprefix("double-conversion/double-conversion/"): h
        for h in glob(["double-conversion/double-conversion/*.h"])
    },
    visibility = ["PUBLIC"],
)

# ---------------------------------------------------------------------------
# v8-bigint: V8's standalone BigInt core (see docs/bigint-plan.md and
# v8-bigint/regen.sh).  Sources include their own headers as
# "src/bigint/...", so the exported headers keep that namespace.  The
# archive is merged into libecho.a by //:srcdir-tree (the echo-dtoa
# pattern) via //runtime:echo-bigint.
# ---------------------------------------------------------------------------

cxx_library(
    name = "v8-bigint",
    srcs = glob(["v8-bigint/src/bigint/*.cc"]),
    header_namespace = "",
    exported_headers = {
        h.removeprefix("v8-bigint/"): h
        for h in glob(["v8-bigint/src/bigint/*.h"])
    },
    compiler_flags = [
        "-g",
        "-O2",
        "-std=c++20",
        "-Wall",
        # Toom-Cook/FFT multiplication and Barrett division are gated
        # behind this in the V8 tree (on for chromium builds)
        "-DV8_ADVANCED_BIGINT_ALGORITHMS=1",
    ],
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

# ---------------------------------------------------------------------------
# JS sources for the compiler itself (esprima & friends), staged into the
# --srcdir tree and fed through babel for the stage0 (node-hosted) compiler.
# ---------------------------------------------------------------------------

filegroup(
    name = "compiler-js",
    srcs = glob([
        "acorn/acorn-es6.js",
        "acorn/acorn-es6.d.ts",
        "esprima/esprima-es6.js",
        "esprima/esprima-es6.d.ts",
        "escodegen/escodegen-es6.js",
        "escodegen/escodegen-es6.d.ts",
        "estraverse/estraverse-es6.js",
        "esutils/esutils-es6.js",
        "esutils/lib/*.js",
    ]),
    visibility = ["PUBLIC"],
)

# ---------------------------------------------------------------------------
# echojs-maam: the MAAM type oracle, compiled into the bootstrap.  Two
# flavors of the same src/: the ESM build (dist/src — star re-exports and
# .js-suffixed specifiers intact; the self-hosted compiler compiles these
# modules in), and the CommonJS build (dist/cjs — what the node-hosted
# stage0 require()s).  Emit-only (--noCheck): the maam repo owns its own
# typechecking; typescript comes from the repo's node_modules, the same
# treatment as //lib's tsc steps.  Maps/declarations are disabled so the
# output tree is deterministic build input.
# ---------------------------------------------------------------------------

genrule(
    name = "maam-esm",
    srcs = glob(["echojs-maam/src/**/*.ts"]) + [
        # package.json carries "type": "module" — without it staged,
        # tsc's NodeNext mode silently emits CommonJS
        "echojs-maam/package.json",
        "echojs-maam/tsconfig.json",
        "echojs-maam/tsconfig.build.json",
    ],
    out = "maam-esm",
    cmd = 'set -e; REPO="${TMP%%/buck-out/*}"; TSC="$REPO/node_modules/typescript/bin/tsc"; ' +
          'mkdir -p "$OUT"; OUTABS="`cd \"$OUT\" && pwd`"; ' +
          'cd "$SRCDIR/echojs-maam"; ' +
          'node "$TSC" -p tsconfig.build.json --noCheck ' +
          '--declaration false --declarationMap false --sourceMap false ' +
          '--outDir "$OUTABS"',
    visibility = ["PUBLIC"],
)

genrule(
    name = "maam-cjs",
    srcs = glob(["echojs-maam/src/**/*.ts"]) + [
        "echojs-maam/package.json",
        "echojs-maam/tsconfig.json",
        "echojs-maam/tsconfig.build.json",
        "echojs-maam/tsconfig.cjs.json",
    ],
    out = "maam-cjs",
    cmd = 'set -e; REPO="${TMP%%/buck-out/*}"; TSC="$REPO/node_modules/typescript/bin/tsc"; ' +
          'mkdir -p "$OUT"; OUTABS="`cd \"$OUT\" && pwd`"; ' +
          'cd "$SRCDIR/echojs-maam"; ' +
          'node "$TSC" -p tsconfig.cjs.json --noCheck ' +
          '--declaration false --declarationMap false --sourceMap false ' +
          '--outDir "$OUTABS"',
    visibility = ["PUBLIC"],
)
